---
import { whatsappLink } from '../data/site';

const links = [
  { href: '/servicos', label: 'Serviços' },
  { href: '/reforma-tributaria', label: 'Reforma Tributária' },
  { href: '/avisos', label: 'Avisos' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/contato', label: 'Contato' },
];
const atual = Astro.url.pathname;
const ativo = (href: string) => atual === href || atual.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-pedra bg-white/95 backdrop-blur">
  <div class="container-g2a flex h-18 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="G2A Soluções Contábeis, página inicial">
      <img src="/img/logo.png" alt="G2A Soluções Contábeis" width="1080" height="494" class="h-11 w-auto" />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-[0.95rem] font-medium">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={ativo(l.href) ? 'page' : undefined}
                class="py-2 text-tinta/80 transition-colors hover:text-navy aria-[current=page]:text-navy aria-[current=page]:shadow-[inset_0_-2px_0_var(--color-ciano)]"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener"
        class="hidden rounded-md bg-navy px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-navy-deep sm:inline-flex"
      >
        Falar com um contador
      </a>

      <details class="group relative lg:hidden">
        <summary
          class="flex size-11 cursor-pointer list-none items-center justify-center rounded-md text-navy hover:bg-pedra [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menu"
        >
          <svg class="size-6 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="hidden size-6 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </summary>
        <nav aria-label="Menu" class="absolute right-0 mt-2 w-64 rounded-lg border border-pedra bg-white p-2 shadow-lg">
          <ul>
            {
              links.map((l) => (
                <li>
                  <a href={l.href} aria-current={ativo(l.href) ? 'page' : undefined} class="block rounded-md px-3 py-3 font-medium text-tinta hover:bg-pedra aria-[current=page]:text-ciano-escuro">
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li class="mt-2 border-t border-pedra pt-2 sm:hidden">
              <a href={whatsappLink()} target="_blank" rel="noopener" class="block rounded-md bg-navy px-3 py-3 text-center font-semibold text-white">
                Falar com um contador
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
