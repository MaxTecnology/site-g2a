---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import { whatsappLink } from '../data/site';
import { DIAS, MODELOS_SEMANA } from '../lib/jornada';
// Planejador da nova escala (fim da 6x1). Roda inteiro no navegador: nenhum dado de
// colaborador vai para o servidor. Regras em src/lib/jornada.ts (testadas).

const campoDia =
  'w-full rounded-md border border-cinza/30 bg-white px-1 py-2 text-center text-sm tabular-nums text-tinta placeholder:text-cinza/60 focus:border-ciano focus:outline-none focus:ring-2 focus:ring-ciano/30';
---

<Base
  titulo="Controle de jornada: fim da escala 6x1"
  descricao="Ferramenta gratuita da G2A: cadastre os colaboradores e veja quem precisa mudar de escala com o fim da 6x1, como fica a nova semana e quando é preciso acordo de compensação."
>
  <Cabecalho
    titulo="Quem da sua equipe precisa mudar de escala?"
    intro="Com o fim da escala 6x1, a jornada passa a ter um limite semanal menor e 2 folgas. Cadastre seus colaboradores e veja, para cada um, como fica a nova semana. Os dados ficam só neste navegador."
  />

  <div class="container-g2a py-12 md:py-16">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-cinza">
      <label for="etapa">Comparando com a regra</label>
      <select id="etapa" class="rounded-md border border-cinza/30 bg-white px-3 py-2 font-semibold text-navy focus:border-ciano focus:outline-none focus:ring-2 focus:ring-ciano/30">
        <option value="42" selected>de 16/12/2026: até 42h e 2 folgas</option>
        <option value="40">de 16/12/2027: até 40h e 2 folgas</option>
        <option value="44">atual: até 44h e 1 folga</option>
      </select>
      <a href="#base-legal" class="text-sm underline underline-offset-4">de onde vem essa regra</a>
    </p>

    <div class="mt-10 grid gap-10 lg:grid-cols-[22rem_1fr] lg:gap-14">
      <!-- Adicionar -->
      <aside class="self-start lg:sticky lg:top-28">
        <form id="form-add" class="rounded-lg bg-pedra p-5 md:p-6" novalidate autocomplete="off">
          <h2 class="titulo-medio text-2xl text-navy">Adicionar colaborador</h2>
          <label class="mt-5 block font-medium">Nome
            <input name="nome" required maxlength="80" class="mt-1.5 block w-full rounded-md border border-cinza/30 bg-white px-3.5 py-2.5 focus:border-ciano focus:outline-none focus:ring-2 focus:ring-ciano/30" />
          </label>

          <fieldset class="mt-5">
            <legend class="font-medium">Como é a semana dele hoje?</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              {MODELOS_SEMANA.map((m, i) => (
                <button type="button" data-modelo={i} class="rounded-full bg-white px-3 py-1.5 text-sm text-navy ring-1 ring-navy/15 hover:ring-navy/40">{m.rotulo}</button>
              ))}
            </div>
            <p class="mt-3 text-sm text-cinza">Ou digite as horas de cada dia (ex.: 8, 8:30). Vazio é folga.</p>
            <div class="mt-2 grid grid-cols-7 gap-1.5">
              {DIAS.map((d, i) => (
                <label class="text-center text-xs font-semibold text-cinza">
                  {d}
                  <input name={`d${i}`} inputmode="decimal" placeholder="–" aria-label={`Horas de ${d} (vazio é folga)`} class:list={[campoDia, 'mt-1']} />
                </label>
              ))}
            </div>
          </fieldset>

          <p id="add-erro" class="mt-3 text-sm font-medium text-red-700" role="alert" hidden></p>
          <button type="submit" class="mt-5 w-full rounded-md bg-navy px-5 py-3 font-semibold text-white hover:bg-navy-deep">Adicionar à lista</button>
        </form>

        <details class="mt-4 rounded-lg p-5 ring-1 ring-pedra">
          <summary class="cursor-pointer font-semibold text-navy">Muitos funcionários? Importe uma planilha</summary>
          <p class="mt-3 text-sm text-cinza">
            Uma linha por colaborador, com as colunas <b>Nome</b> e as horas de <b>Seg</b> a <b>Dom</b>. Ou só <b>Jornada semanal</b> e <b>Dias trabalhados</b>.
            Opcionais: Matrícula, Cargo, Setor.
          </p>
          <div class="mt-4 flex flex-col gap-2">
            <label class="block cursor-pointer rounded-md bg-navy px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-navy-deep focus-within:outline-3 focus-within:outline-offset-2 focus-within:outline-ciano">
              Escolher planilha (.xlsx ou .csv)
              <input type="file" id="arquivo" accept=".xlsx,.xls,.csv" class="sr-only" />
            </label>
            <button type="button" id="btn-modelo" class="rounded-md px-4 py-2.5 text-sm font-semibold text-navy ring-1 ring-navy/20 hover:bg-pedra">Baixar planilha modelo</button>
          </div>
          <p id="imp-msg" class="mt-3 text-sm" role="status"></p>
        </details>
      </aside>

      <!-- Resultado -->
      <section aria-labelledby="resultado-titulo">
        <h2 id="resultado-titulo" class="sr-only">Resultado</h2>

        <div id="vazio" class="rounded-lg p-8 text-center ring-1 ring-pedra" hidden>
          <p class="titulo-medio text-2xl text-navy">Sua lista está vazia</p>
          <p class="mx-auto mt-2 max-w-md text-cinza">Adicione o primeiro colaborador no formulário ao lado e o resultado aparece aqui.</p>
          <button type="button" id="btn-exemplo" class="mt-5 font-semibold text-ciano-escuro underline underline-offset-4">Ver um exemplo com 6 colaboradores</button>
        </div>

        <div id="com-dados" hidden>
          <div id="exemplo-aviso" class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-lg bg-amber-50 px-5 py-3 text-sm ring-1 ring-amber-200" hidden>
            <span>Estes são <b>colaboradores de exemplo</b>.</span>
            <button type="button" id="btn-limpar-exemplo" class="font-semibold text-navy underline underline-offset-4">Apagar o exemplo e começar a minha lista</button>
          </div>

          <p id="resumo" class="titulo-medio text-2xl text-navy md:text-3xl" aria-live="polite"></p>
          <p id="resumo-sub" class="mt-2 text-cinza"></p>

          <ul id="lista" class="mt-8 space-y-4"></ul>

          <div class="mt-10 rounded-lg bg-navy p-6 text-white md:p-8">
            <p class="titulo-medio text-2xl">Quer ajuda para colocar a nova escala em prática?</p>
            <p class="mt-2 max-w-prose text-white/75">
              Acordo de compensação, convenção coletiva e ajuste do ponto eletrônico ficam com o nosso departamento pessoal.
              O resumo enviado leva só os números, sem o nome dos colaboradores.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a id="btn-whatsapp" href={whatsappLink()} target="_blank" rel="noopener" class="rounded-md bg-ciano px-5 py-3 font-semibold text-navy-deep hover:bg-ceu">Enviar resumo pelo WhatsApp</a>
              <button type="button" id="btn-exportar" class="rounded-md px-5 py-3 font-semibold text-white ring-1 ring-white/30 hover:bg-white/10">Baixar a nova escala (.xlsx)</button>
            </div>
          </div>

          <p class="mt-6 text-sm">
            <button type="button" id="btn-apagar" class="font-semibold text-red-700 underline underline-offset-4">Apagar todos os colaboradores</button>
            <span id="confirma-apagar" class="ml-2" hidden>
              Tem certeza?
              <button type="button" id="btn-apagar-sim" class="ml-2 font-semibold text-red-700 underline underline-offset-4">Sim, apagar</button>
              <button type="button" id="btn-apagar-nao" class="ml-2 underline underline-offset-4">Cancelar</button>
            </span>
          </p>
        </div>
      </section>
    </div>

    <div id="base-legal" class="mt-16 max-w-[80ch] scroll-mt-28 border-t border-pedra pt-8 text-sm text-cinza">
      <h2 class="font-semibold text-navy">Regras usadas</h2>
      <p class="mt-2">
        Até 15/12/2026 vale o limite de 44h semanais. De 16/12/2026 em diante, 42h e 2 dias de descanso por semana. A partir
        de 16/12/2027, 40h. Na etapa de 42h, se não houver acordo ou convenção coletiva até 15/12/2026, a empresa pode
        distribuir as 42h em 5 dias de até 8h24, sem hora extra pelos 24 minutos, até 15/12/2027. Fora disso, dia acima de 8h
        exige acordo de compensação ou previsão em convenção coletiva, e nenhum dia pode passar de 10h (CLT, arts. 58 e 59).
      </p>
      <p class="mt-2">
        Cláusulas de acordos e convenções incompatíveis com a nova regra perdem a validade a partir de 16/12/2026, e há 90 dias
        para renegociar. Acordos e convenções podem definir outras formas de compensar as folgas.
      </p>
      <p class="mt-2">
        Fonte: decisão liminar do ministro Flávio Dino (STF, ADIs 8.041 e 8.042, 12/11/2026), sujeita ao referendo do
        plenário. Regras atualizadas em 15/11/2026.
      </p>
      <p class="mt-2">
        A ferramenta faz uma sugestão inicial. Horas extras habituais, escalas especiais e regras da convenção coletiva da sua
        categoria devem ser conferidas pelo departamento pessoal.
      </p>
    </div>
  </div>
</Base>

<script>
  import {
    DIAS, MODELOS_SEMANA, fmt, parseH, soma, horaValida, folgasMinimas, sugerirEscala, escalaSemAcordo,
    exigeAcordo, analisar, limiteDiarioSemAcordo, linhaParaColaborador, resumoSemana, esc, type Colaborador, type Escala,
  } from '../lib/jornada';
  import { whatsappLink } from '../data/site';

  type Pessoa = Colaborador & { semAcordo?: boolean };
  type Estado = { emps: Pessoa[]; etapa: number; exemplo?: boolean };

  const CHAVE = 'planejador-jornada-5x2.v1';
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;

  // ---------- estado ----------
  function carregar(): Estado {
    try {
      const s = JSON.parse(localStorage.getItem(CHAVE) ?? 'null');
      if (s && Array.isArray(s.emps)) return { emps: s.emps, etapa: s.etapa || 42, exemplo: s.exemplo };
    } catch {}
    return { emps: [], etapa: 42 };
  }
  let estado = carregar();
  let tSalvar: ReturnType<typeof setTimeout>;
  const salvar = () => {
    clearTimeout(tSalvar);
    tSalvar = setTimeout(() => {
      try { localStorage.setItem(CHAVE, JSON.stringify(estado)); } catch {}
    }, 200);
  };
  // Daily limit without agreement follows the selected stage (8h24 in the 42h transition, 8h otherwise).
  const limdia = () => limiteDiarioSemAcordo(estado.etapa);
  const cfg = () => ({ etapa: estado.etapa, limdia: limdia() });
  const proposta = (e: Pessoa) => (e.prop ??= sugerirEscala(e.atual, estado.etapa));

  function exemplo(): Pessoa[] {
    const H = (h: number) => Math.round(h * 60);
    return ([
      ['1001', 'Maria Souza', 'Atendente', 'Loja', [8, 8, 8, 8, 8, 4, 0]],
      ['1002', 'João Lima', 'Estoquista', 'Depósito', [8, 8, 8, 8, 8, 4, 0]],
      ['1003', 'Ana Ferreira', 'Caixa', 'Loja', [7.33, 7.33, 7.33, 7.33, 7.33, 7.33, 0]],
      ['1004', 'Carlos Melo', 'Repositor', 'Loja', [0, 8, 8, 8, 8, 8, 4]],
      ['1005', 'Paula Rocha', 'Auxiliar administrativo', 'Escritório', [8, 8, 8, 8, 8, 0, 0]],
      ['1006', 'Rafael Dias', 'Vendedor (meio período)', 'Loja', [6, 6, 6, 6, 6, 0, 0]],
    ] as const).map(([mat, nome, cargo, setor, d]) => ({ id: mat, mat, nome, cargo, setor, atual: d.map(H), prop: null }));
  }

  // ---------- render ----------
  const pill = (txt: string, tom: 'ok' | 'warn') =>
    `<span class="rounded-full px-2.5 py-1 text-xs font-semibold ${tom === 'ok' ? 'bg-emerald-50 text-emerald-800' : 'bg-amber-50 text-amber-800'}">${txt}</span>`;

  function cartao(e: Pessoa, i: number) {
    const prop = proposta(e);
    const a = analisar({ atual: e.atual, prop }, cfg());
    const criticos = a.alerts.filter(([k]) => k === 'crit');
    const acordo = exigeAcordo(prop, limdia());
    const alternativa = escalaSemAcordo(e.atual, estado.etapa, limdia());
    const temAlternativa = acordo && soma(alternativa) > 0 && !e.semAcordo;
    const transicao = !acordo && estado.etapa === 42 && Math.max(...prop) > 480;
    const sub = [e.cargo, e.setor].filter(Boolean).map(esc).join(' · ');

    const dias = DIAS.map((d, j) => {
      const v = prop[j];
      return `<label class="text-center text-xs font-semibold text-cinza">${d}
        <input data-i="${i}" data-d="${j}" value="${v ? fmt(v, 'in') : ''}" placeholder="folga" inputmode="decimal"
          aria-label="${d}, nova escala de ${esc(e.nome)}"
          class="mt-1 w-full rounded-md border px-0.5 py-2 text-center text-sm tabular-nums focus:border-ciano focus:outline-none focus:ring-2 focus:ring-ciano/30 ${v ? 'border-cinza/30 bg-white text-tinta' : 'border-transparent bg-pedra text-cinza'} ${v > limdia() ? 'font-semibold text-amber-800' : ''}" />
      </label>`;
    }).join('');

    let explicacao = '';
    if (criticos.length) {
      explicacao = `<div class="mt-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
        <b>Esta escala não atende à regra:</b> ${criticos.map(([, t]) => esc(t).toLowerCase()).join('; ')}.
        <button type="button" data-acao="sugerir" data-i="${i}" class="ml-1 font-semibold underline underline-offset-4">Voltar para a sugestão</button></div>`;
    } else if (acordo) {
      explicacao = `<div class="mt-4 rounded-md bg-ceu/20 px-4 py-3 text-sm text-navy">
        Com ${fmt(soma(prop))} em ${a.diasNv} dias, há dia acima de ${fmt(limdia())}: isso exige <b>acordo de compensação</b> ou previsão na convenção coletiva.
        ${temAlternativa ? `<button type="button" data-acao="sem-acordo" data-i="${i}" class="mt-1 block text-left font-semibold text-ciano-escuro underline underline-offset-4">Ver opção sem acordo: ${resumoSemana(alternativa)}, até ${fmt(limdia())} por dia</button>` : ''}
      </div>`;
    } else if (transicao) {
      explicacao = `<div class="mt-4 rounded-md bg-pedra px-4 py-3 text-sm text-cinza">
        Dias de até 8h24 são permitidos na transição para 42h, sem acordo e sem hora extra pelos 24 minutos, até 15/12/2027
        (liminar do STF). Se a convenção coletiva da categoria trouxer outra regra, vale a convenção.</div>`;
    } else if (e.semAcordo) {
      explicacao = `<div class="mt-4 rounded-md bg-pedra px-4 py-3 text-sm text-cinza">
        Opção sem acordo de compensação: a semana fica com ${fmt(soma(prop))}, abaixo do limite de ${estado.etapa}h.
        <button type="button" data-acao="sugerir" data-i="${i}" class="ml-1 font-semibold text-ciano-escuro underline underline-offset-4">Voltar para ${estado.etapa}h</button></div>`;
    }

    const mudanca = a.precisa
      ? `Hoje: <b>${resumoSemana(e.atual)}</b> · Nova escala: <b>${resumoSemana(prop)}</b>`
      : `<b>${resumoSemana(e.atual)}</b>: já atende à regra, nada muda.`;

    return `<li class="rounded-lg p-5 ring-1 ring-pedra md:p-6">
      <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
        <div><p class="font-semibold text-navy">${esc(e.nome)}</p>${sub ? `<p class="text-sm text-cinza">${sub}</p>` : ''}</div>
        <div class="flex items-center gap-3">
          ${a.precisa ? pill('Precisa mudar', 'warn') : pill('Já está na regra', 'ok')}
          <button type="button" data-acao="remover" data-i="${i}" class="text-sm text-cinza underline underline-offset-4 hover:text-red-700">Remover<span class="sr-only"> ${esc(e.nome)}</span></button>
        </div>
      </div>
      <p class="mt-3 text-[0.95rem]">${mudanca}</p>
      ${a.precisa || criticos.length ? `<div class="mt-4 grid max-w-xl grid-cols-7 gap-1.5">${dias}</div>` : ''}
      ${explicacao}
    </li>`;
  }

  function render() {
    const n = estado.emps.length;
    $('#vazio').hidden = n > 0;
    $('#com-dados').hidden = n === 0;
    $('#exemplo-aviso').hidden = !estado.exemplo;
    $<HTMLSelectElement>('#etapa').value = String(estado.etapa);
    if (!n) return;

    const analises = estado.emps.map((e) => ({ e, a: analisar({ atual: e.atual, prop: proposta(e) }, cfg()) }));
    const mudam = analises.filter((x) => x.a.precisa).length;
    const reduzir = analises.reduce((s, x) => s + x.a.reduzir, 0);
    $('#resumo').textContent = mudam
      ? `${mudam} de ${n} ${n === 1 ? 'colaborador precisa' : 'colaboradores precisam'} mudar de escala.`
      : `${n === 1 ? 'O colaborador já atende' : `Os ${n} colaboradores já atendem`} à regra de ${estado.etapa}h.`;
    $('#resumo-sub').textContent = reduzir ? `Juntos, são ${fmt(reduzir)} de trabalho a menos por semana. Ajuste as horas de qualquer dia se quiser.` : '';

    $('#lista').innerHTML = estado.emps.map(cartao).join('');
    $<HTMLAnchorElement>('#btn-whatsapp').href = whatsappLink(mensagem(analises.map((x) => x.a), mudam));
  }

  function mensagem(analises: ReturnType<typeof analisar>[], mudam: number) {
    const acordo = estado.emps.filter((e) => exigeAcordo(proposta(e), limdia())).length;
    return [
      'Olá! Usei o controle de jornada do site da G2A.',
      `Regra: até ${estado.etapa}h e ${folgasMinimas(estado.etapa)} folga${folgasMinimas(estado.etapa) > 1 ? 's' : ''} por semana.`,
      `Equipe: ${analises.length} ${analises.length === 1 ? 'colaborador' : 'colaboradores'}. ` +
        `Precisam mudar de escala: ${mudam}.` +
        (acordo ? ` Com dias acima de ${fmt(limdia())} (acordo de compensação): ${acordo}.` : ''),
      'Quero ajuda para adaptar a escala.',
    ].join('\n');
  }

  // ---------- adicionar ----------
  const form = $<HTMLFormElement>('#form-add');
  const erro = $('#add-erro');
  form.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-modelo]');
    if (!b) return;
    MODELOS_SEMANA[+b.dataset.modelo!].dias.forEach((v, j) => {
      (form.elements.namedItem(`d${j}`) as HTMLInputElement).value = v ? fmt(v, 'in') : '';
    });
  });
  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const nome = (form.elements.namedItem('nome') as HTMLInputElement).value.trim();
    const atual: Escala = DIAS.map((_, j) => parseH((form.elements.namedItem(`d${j}`) as HTMLInputElement).value));
    const msg = !nome
      ? 'Informe o nome do colaborador.'
      : atual.some((v) => !horaValida(v))
        ? 'Alguma hora não foi entendida. Use 8, 8:30 ou 8h30, até 24h por dia.'
        : soma(atual) === 0
          ? 'Informe as horas de pelo menos um dia, ou escolha uma das semanas prontas.'
          : '';
    erro.textContent = msg;
    erro.hidden = !msg;
    if (msg) return;
    if (estado.exemplo) { estado.emps = []; estado.exemplo = false; }
    const id = `M${Date.now().toString(36)}`;
    estado.emps.push({ id, mat: id, nome, cargo: '', setor: '', atual, prop: null });
    salvar();
    render();
    form.reset();
    (form.elements.namedItem('nome') as HTMLInputElement).focus();
  });

  // ---------- editar / ações nos cartões ----------
  const lista = $('#lista');
  lista.addEventListener('change', (ev) => {
    const t = ev.target as HTMLInputElement;
    if (!t.dataset.d) return;
    const v = parseH(t.value);
    if (!horaValida(v)) { t.setCustomValidity('Hora inválida'); t.reportValidity(); return; }
    t.setCustomValidity('');
    const e = estado.emps[+t.dataset.i!];
    proposta(e)[+t.dataset.d] = v;
    e.semAcordo = false;
    salvar();
    const foco = `[data-i="${t.dataset.i}"][data-d="${t.dataset.d}"]`;
    render();
    document.querySelector<HTMLInputElement>(foco)?.focus();
  });
  lista.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-acao]');
    if (!b) return;
    const i = +b.dataset.i!;
    const e = estado.emps[i];
    if (b.dataset.acao === 'remover') estado.emps.splice(i, 1);
    if (b.dataset.acao === 'sem-acordo') { e.prop = escalaSemAcordo(e.atual, estado.etapa, limdia()); e.semAcordo = true; }
    if (b.dataset.acao === 'sugerir') { e.prop = sugerirEscala(e.atual, estado.etapa); e.semAcordo = false; }
    if (!estado.emps.length) estado.exemplo = false;
    salvar();
    render();
  });

  $<HTMLSelectElement>('#etapa').addEventListener('change', (ev) => {
    estado.etapa = +(ev.target as HTMLSelectElement).value;
    estado.emps.forEach((e) => { e.prop = null; e.semAcordo = false; });
    salvar();
    render();
  });

  $('#btn-exemplo').addEventListener('click', () => { estado.emps = exemplo(); estado.exemplo = true; salvar(); render(); });
  $('#btn-limpar-exemplo').addEventListener('click', () => { estado.emps = []; estado.exemplo = false; salvar(); render(); });
  $('#btn-apagar').addEventListener('click', () => { $('#confirma-apagar').hidden = false; });
  $('#btn-apagar-nao').addEventListener('click', () => { $('#confirma-apagar').hidden = true; });
  $('#btn-apagar-sim').addEventListener('click', () => {
    estado.emps = []; estado.exemplo = false; $('#confirma-apagar').hidden = true; salvar(); render();
  });

  // ---------- planilha (SheetJS só carrega quando for usado) ----------
  declare const XLSX: any;
  let xlsxCarregando: Promise<void> | null = null;
  function carregarXlsx() {
    if (typeof XLSX !== 'undefined') return Promise.resolve();
    return (xlsxCarregando ??= new Promise<void>((ok, falha) => {
      const s = document.createElement('script');
      s.src = '/vendor/xlsx.full.min.js';
      s.onload = () => ok();
      s.onerror = () => { xlsxCarregando = null; falha(new Error('xlsx')); };
      document.head.append(s);
    }));
  }
  function baixar(nome: string, dados: ArrayBuffer) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([dados]));
    a.download = nome;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  }
  function planilha(nome: string, linhas: unknown[][], larguras: number[]) {
    const wb = XLSX.utils.book_new();
    const ws = XLSX.utils.aoa_to_sheet(linhas);
    ws['!cols'] = larguras.map((wch) => ({ wch }));
    XLSX.utils.book_append_sheet(wb, ws, nome);
    return XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
  }

  const impMsg = $('#imp-msg');
  const avisar = (txt: string, tipo: 'ok' | 'erro' | '' = '') => {
    impMsg.textContent = txt;
    impMsg.className = `mt-3 text-sm ${tipo === 'erro' ? 'font-medium text-red-700' : tipo === 'ok' ? 'font-medium text-emerald-800' : 'text-cinza'}`;
  };

  $<HTMLInputElement>('#arquivo').addEventListener('change', async (ev) => {
    const input = ev.target as HTMLInputElement;
    const arq = input.files?.[0];
    input.value = '';
    if (!arq) return;
    avisar('Lendo a planilha…');
    try {
      await carregarXlsx();
      const wb = XLSX.read(new Uint8Array(await arq.arrayBuffer()), { type: 'array' });
      // raw:false: read cells as displayed, so Excel durations like 44:00 are not taken as days.
      const linhas = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { defval: '', raw: false });
      let novos = 0, atualizados = 0;
      const semHoras: string[] = [], invalidos: string[] = [];
      if (estado.exemplo) { estado.emps = []; estado.exemplo = false; }
      linhas.forEach((r: Record<string, unknown>, i: number) => {
        const out = linhaParaColaborador(r, i);
        if (!out) return;
        if ('semHoras' in out) return void semHoras.push(out.semHoras);
        if ('invalido' in out) return void invalidos.push(out.invalido);
        const ex = estado.emps.findIndex((e) => e.mat === out.colaborador.mat);
        if (ex >= 0) { estado.emps[ex] = out.colaborador; atualizados++; } else { estado.emps.push(out.colaborador); novos++; }
      });
      salvar();
      render();
      const lista5 = (xs: string[]) => xs.slice(0, 5).join(', ') + (xs.length > 5 ? '…' : '');
      const partes = [
        novos || atualizados ? `${novos} colaborador(es) adicionado(s)${atualizados ? `, ${atualizados} atualizado(s)` : ''}.` : 'Nenhum colaborador encontrado: confira se há a coluna Nome e as horas.',
        semHoras.length ? `Sem horas: ${lista5(semHoras)}.` : '',
        invalidos.length ? `Horas que não entendemos (confira na planilha): ${lista5(invalidos)}.` : '',
      ];
      avisar(partes.filter(Boolean).join(' '), novos || atualizados ? 'ok' : 'erro');
    } catch {
      avisar('Não conseguimos ler esse arquivo. Salve como .xlsx ou .csv e tente de novo.', 'erro');
    }
  });

  $('#btn-modelo').addEventListener('click', async () => {
    try {
      await carregarXlsx();
      baixar('modelo-colaboradores.xlsx', planilha('Colaboradores', [
        ['Matrícula', 'Nome', 'Cargo', 'Setor', ...DIAS],
        ['1001', 'Nome do colaborador', 'Cargo', 'Setor', '08:00', '08:00', '08:00', '08:00', '08:00', '04:00', ''],
      ], [11, 30, 20, 16, 7, 7, 7, 7, 7, 7, 7]));
    } catch { avisar('Não foi possível gerar o modelo agora. Verifique a conexão.', 'erro'); }
  });

  $('#btn-exportar').addEventListener('click', async () => {
    try {
      await carregarXlsx();
      const h = (m: number) => (m ? Math.round((m / 60) * 100) / 100 : 0);
      const linhas = estado.emps.map((e) => {
        const prop = proposta(e);
        const a = analisar({ atual: e.atual, prop }, cfg());
        return [e.mat, e.nome, e.cargo, e.setor, h(a.atual), h(a.tot), ...prop.map((v) => (v ? fmt(v, 'in') : 'folga')),
          a.precisa ? 'Mudar' : 'Já atende', exigeAcordo(prop, limdia()) ? 'Sim' : 'Não'];
      });
      baixar(`nova-escala-${estado.etapa}h.xlsx`, planilha('Nova escala', [
        ['Matrícula', 'Nome', 'Cargo', 'Setor', 'Horas hoje', 'Horas na nova escala', ...DIAS, 'Situação', 'Exige acordo de compensação'],
        ...linhas,
      ], [11, 28, 18, 14, 11, 18, 7, 7, 7, 7, 7, 7, 7, 11, 26]));
    } catch { alert('Não foi possível gerar a planilha agora. Verifique a conexão e tente de novo.'); }
  });

  render();
</script>
