---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import { whatsappLink } from '../data/site';
// Planejador de jornada 5x2 (fim da escala 6x1). Roda inteiro no navegador do visitante:
// nenhum dado de colaborador é enviado ao servidor. Persistência em localStorage + backup .json.
---

<Base
  titulo="Controle de jornada: fim da escala 6x1"
  descricao="Ferramenta gratuita da G2A para adaptar a escala dos colaboradores ao fim da 6x1 (EC 141/2026): importe a planilha, veja quanto cada um precisa reduzir e acompanhe as horas da semana."
>
  <Cabecalho
    titulo="Controle de jornada para o fim da escala 6x1"
    intro="Importe a planilha com a escala dos seus colaboradores, veja quanto cada um precisa reduzir para 42h e 2 folgas e acompanhe as horas da semana. Os dados ficam só no seu computador."
  >
    <p class="mt-6 text-sm text-white/70">
      Dúvidas sobre acordo de compensação ou convenção coletiva?{' '}
      <a class="font-semibold text-ceu underline underline-offset-4" href={whatsappLink('Olá! Quero ajuda com a adaptação da escala 6x1 dos meus funcionários.')} target="_blank" rel="noopener">Fale com o nosso departamento pessoal</a>.
    </p>
  </Cabecalho>

  <div class="pj">
<div class="wrap container-g2a">
  <div class="pj-barra">
    <p>Escolha a etapa da lei para comparar as escalas. O limite diário define quando um dia passa a exigir acordo de compensação.</p>
    <div class="rule" style="margin-left:0">
      <label class="f" for="etapa">Etapa da lei
        <select id="etapa">
          <option value="44">Atual · 44h/semana</option>
          <option value="42" selected>A partir de 16/12/2026 · 42h e 2 folgas</option>
          <option value="40">A partir de 16/12/2027 · 40h e 2 folgas</option>
        </select>
      </label>
      <label class="f" for="limdia">Limite diário sem acordo
        <select id="limdia">
          <option value="480" selected>8h</option>
          <option value="528">8h48</option>
          <option value="600">10h</option>
        </select>
      </label>
    </div>
  </div>
  <nav class="tabs" aria-label="Etapas do planejador">
    <a href="#importar" data-v="importar">1. Importar planilha</a>
    <a href="#analise" data-v="analise">2. Análise e nova escala <span class="ct" id="ctA">0</span></a>
    <a href="#semana" data-v="semana">3. Controle da semana</a>
  </nav>

  <div class="banner" id="exBanner" hidden>
    <span><b>Dados de exemplo.</b> Importe a planilha da empresa para substituir.</span>
    <button class="sm" id="goImport">Importar planilha</button>
  </div>

  <!-- IMPORTAR -->
  <section id="v-importar" hidden>
    <div class="drop" id="drop">
      <strong>Arraste a planilha aqui (.xlsx, .xls ou .csv)</strong>
      <p>ou</p>
      <label for="file" class="hint">Escolher arquivo:</label>
      <input type="file" id="file" accept=".xlsx,.xls,.csv">
      <p class="hint">A primeira aba é lida. Linhas com a mesma matrícula são atualizadas.</p>
      <div class="msg" id="impMsg" role="status"></div>
    </div>
    <div class="bar" style="margin-top:12px">
      <button id="btnModelo">Baixar planilha modelo</button>
      <button id="btnBackup">Salvar backup (.json)</button>
      <label for="restore" class="hint" style="display:inline-flex;gap:6px;align-items:center">Restaurar backup <input type="file" id="restore" accept=".json"></label>
      <span class="grow"></span>
      <button class="danger" id="btnLimpar">Apagar todos os dados</button>
      <span class="confirm" id="cfLimpar">Apagar colaboradores e lançamentos? <button class="sm danger" id="cfSim">Apagar</button><button class="sm" id="cfNao">Cancelar</button></span>
    </div>
    <div class="cols">
      <div class="card">
        <h3>Colunas reconhecidas</h3>
        <ul>
          <li><code>Matrícula</code>, <code>Nome</code>, <code>Cargo</code>, <code>Setor</code></li>
          <li>Horas por dia: <code>Seg</code> <code>Ter</code> <code>Qua</code> <code>Qui</code> <code>Sex</code> <code>Sáb</code> <code>Dom</code> (ou o nome do dia por extenso)</li>
          <li>Ou só <code>Jornada semanal</code> + <code>Dias trabalhados</code></li>
          <li>Horas em <code>8:24</code>, <code>8h24</code>, <code>8,4</code> ou formato de hora do Excel</li>
        </ul>
      </div>
      <div class="card">
        <h3>O que o sistema faz</h3>
        <ul>
          <li>Compara a escala de cada um com o limite da etapa escolhida</li>
          <li>Calcula quantas horas cada colaborador precisa reduzir</li>
          <li>Sugere a nova escala com 2 folgas, distribuindo as horas por dia</li>
          <li>No controle da semana, as horas lançadas vão abatendo do saldo de cada um</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ANÁLISE -->
  <section id="v-analise" hidden>
    <div class="tiles" id="tilesA"></div>
    <div class="bar">
      <input type="search" id="qA" placeholder="Buscar colaborador" aria-label="Buscar colaborador">
      <select id="fA" aria-label="Filtrar situação">
        <option value="">Todas as situações</option>
        <option value="aj">Precisam ajustar</option>
        <option value="ok">Já conformes</option>
        <option value="al">Com alerta na nova escala</option>
      </select>
      <span class="grow"></span>
      <button id="btnResetProp">Refazer sugestões</button>
      <button class="pri" id="btnExpA">Exportar nova escala (.xlsx)</button>
    </div>
    <p class="hint">A nova escala é uma sugestão: clique nas horas de qualquer dia para ajustar. Deixe vazio para folga.</p>
    <div class="card scroll">
      <table>
        <thead><tr>
          <th>Colaborador</th><th class="n">Hoje</th><th class="n">Nova meta</th><th class="n">Reduzir</th>
          <th class="d">Seg</th><th class="d">Ter</th><th class="d">Qua</th><th class="d">Qui</th><th class="d">Sex</th><th class="d">Sáb</th><th class="d">Dom</th>
          <th class="n">Total</th><th>Situação</th>
        </tr></thead>
        <tbody id="tbA"></tbody>
      </table>
    </div>
  </section>

  <!-- SEMANA -->
  <section id="v-semana" hidden>
    <div class="bar">
      <button class="sm" id="wPrev" aria-label="Semana anterior">◀</button>
      <label class="f" for="wDate">Semana de
        <input type="date" id="wDate">
      </label>
      <button class="sm" id="wNext" aria-label="Próxima semana">▶</button>
      <strong id="wLabel" class="num"></strong>
      <span class="grow"></span>
      <select id="fillDay" aria-label="Dia para preencher"></select>
      <button id="btnFill">Lançar o previsto deste dia</button>
      <button class="pri" id="btnExpS">Exportar semana (.xlsx)</button>
    </div>
    <div class="tiles" id="tilesS"></div>
    <div class="bar"><input type="search" id="qS" placeholder="Buscar colaborador" aria-label="Buscar colaborador na semana"><span class="hint">Digite as horas trabalhadas em cada dia. O saldo da semana diminui sozinho.</span></div>
    <div class="card scroll">
      <table>
        <thead><tr id="thS"></tr></thead>
        <tbody id="tbS"></tbody>
      </table>
    </div>
  </section>

  <div class="pj-notas" style="margin-top:24px;font-size:13px;color:var(--muted);max-width:80ch">
    Regras usadas: EC nº 141/2026 (promulgada em 16/10/2026). Até 15/12/2026 vale o limite de 44h. De 16/12/2026 em diante, 42h e 2 dias de descanso por semana. A partir de 16/12/2027, 40h.
    Dia previsto acima de 8h exige acordo de compensação ou previsão em convenção coletiva (CLT art. 59). Horas extras habituais e casos de convenção coletiva
    devem ser conferidos pelo departamento pessoal. Os dados ficam salvos neste navegador; use “Salvar backup” para guardar uma cópia.
  </div>
</div>
  </div>
</Base>

<script is:inline src="/vendor/xlsx.full.min.js"></script>
<script>
import {
  DIAS as DAYS, fmt, parseH, soma as sum, horaValida, limiteSemanal, folgasMinimas,
  sugerirEscala, analisar, linhaParaColaborador, esc,
} from '../lib/jornada';

(() => {
"use strict";
const KEY = "planejador-jornada-5x2.v1";
const $ = s => document.querySelector(s);

/* ---------- estado ---------- */
let state = load() || demo();
function demo() {
  const H = h => Math.round(h * 60);
  const emps = [
    ["1001","Maria Souza","Atendente","Loja",[8,8,8,8,8,4,0]],
    ["1002","João Lima","Estoquista","Depósito",[8,8,8,8,8,4,0]],
    ["1003","Ana Ferreira","Caixa","Loja",[7.33,7.33,7.33,7.33,7.33,7.33,0]],
    ["1004","Carlos Melo","Repositor","Loja",[0,8,8,8,8,8,4]],
    ["1005","Paula Rocha","Auxiliar adm.","Escritório",[8,8,8,8,8,0,0]],
    ["1006","Rafael Dias","Vendedor (meio período)","Loja",[6,6,6,6,6,0,0]],
  ].map(([mat,nome,cargo,setor,d]) => ({ id: mat, mat, nome, cargo, setor, atual: d.map(H), prop: null }));
  return { exemplo: true, emps, lanc: {}, etapa: 42, limdia: 480 };
}
function load() { try { const s = localStorage.getItem(KEY); return s ? JSON.parse(s) : null; } catch (e) { return null; } }
let saveT;
function save() { clearTimeout(saveT); saveT = setTimeout(() => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }, 250); }

/* ---------- regras (src/lib/jornada.ts) ---------- */
const folgasMin = () => folgasMinimas(state.etapa);
function analyze(e) {
  if (!e.prop) e.prop = sugerirEscala(e.atual, state.etapa);
  return analisar(e, { etapa: state.etapa, limdia: state.limdia });
}

/* ---------- rotas ---------- */
const VIEWS = ["importar","analise","semana"];
function route() {
  let v = location.hash.slice(1); if (!VIEWS.includes(v)) v = "analise";
  VIEWS.forEach(x => { $("#v-" + x).hidden = x !== v; });
  document.querySelectorAll("nav.tabs a").forEach(a => { if (a.dataset.v === v) a.setAttribute("aria-current", "page"); else a.removeAttribute("aria-current"); });
  render();
}
window.addEventListener("hashchange", route);

/* ---------- ANÁLISE ---------- */
function renderA() {
  const q = $("#qA").value.trim().toLowerCase(), f = $("#fA").value;
  let nAj = 0, red = 0, nAl = 0, rows = [];
  state.emps.forEach((e, idx) => {
    const a = analyze(e);
    if (a.precisa) nAj++;
    red += a.reduzir;
    const temAlerta = a.alerts.some(x => x[0] !== "info");
    if (temAlerta) nAl++;
    if (q && !(e.nome + " " + e.mat + " " + (e.setor||"")).toLowerCase().includes(q)) return;
    if (f === "aj" && !a.precisa) return;
    if (f === "ok" && a.precisa) return;
    if (f === "al" && !temAlerta) return;
    const sit = (a.precisa ? `<span class="pill p-warn">Ajustar</span>` : `<span class="pill p-ok">Já conforme</span>`) +
      (a.alerts.length ? a.alerts.map(([k, t]) => `<span class="pill p-${k}">${t}</span>`).join("") : (a.precisa ? `<span class="pill p-ok">Nova escala OK</span>` : ""));
    const cells = e.prop.map((v, d) => `<td class="d"><input class="h${v ? "" : " off"}" id="p-${idx}-${d}" data-i="${idx}" data-d="${d}" value="${v ? fmt(v, "in") : ""}" placeholder="folga" aria-label="${DAYS[d]} de ${esc(e.nome)}"></td>`).join("");
    rows.push(`<tr>
      <td class="who left"><b>${esc(e.nome)}</b><span>${esc(e.mat)}${e.cargo ? " · " + esc(e.cargo) : ""}${e.setor ? " · " + esc(e.setor) : ""}</span></td>
      <td class="n">${fmt(a.atual)}<br><span class="hint">${a.diasAt} dias</span></td>
      <td class="n"><b>${fmt(a.meta)}</b></td>
      <td class="n">${a.reduzir ? "−" + fmt(a.reduzir) : "—"}</td>
      ${cells}
      <td class="n"><b>${fmt(a.tot)}</b><br><span class="hint">${a.diasNv} dias</span></td>
      <td>${sit}</td></tr>`);
  });
  $("#tbA").innerHTML = rows.join("") || `<tr><td colspan="13" class="hint">Nenhum colaborador encontrado.</td></tr>`;
  const n = state.emps.length;
  $("#tilesA").innerHTML = tile("Colaboradores", n) + tile("Precisam ajustar", nAj, n ? Math.round(nAj / n * 100) + "% da equipe" : "") +
    tile("Horas a reduzir por semana", fmt(red), n ? "média de " + fmt(red / Math.max(nAj, 1)) + " por pessoa ajustada" : "") +
    tile("Com alerta na nova escala", nAl, `limite ${state.etapa}h · ${folgasMin()} folga${folgasMin() > 1 ? "s" : ""}`);
  $("#ctA").textContent = n;
}
$("#tbA").addEventListener("change", ev => {
  const t = ev.target; if (!t.matches("input.h")) return;
  const v = parseH(t.value);
  if (!horaValida(v)) { t.classList.add("bad"); return; }
  t.classList.remove("bad");
  const e = state.emps[+t.dataset.i]; e.prop[+t.dataset.d] = v;
  save(); const id = t.id; renderA(); const nx = document.getElementById(id); if (nx) nx.focus();
});
$("#qA").addEventListener("input", renderA);
$("#fA").addEventListener("change", renderA);
$("#btnResetProp").addEventListener("click", () => { state.emps.forEach(e => e.prop = null); save(); renderA(); });

/* ---------- SEMANA ---------- */
function monday(d) { const x = new Date(d.getFullYear(), d.getMonth(), d.getDate()); x.setDate(x.getDate() - ((x.getDay() + 6) % 7)); return x; }
function iso(d) { return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`; }
function br(d) { return `${String(d.getDate()).padStart(2, "0")}/${String(d.getMonth() + 1).padStart(2, "0")}`; }
let week = monday(new Date());
function weekDates() { return DAYS.map((_, i) => { const x = new Date(week); x.setDate(x.getDate() + i); return x; }); }
function renderS() {
  const wk = iso(week), ds = weekDates(), L = state.lanc[wk] || {};
  $("#wDate").value = wk;
  $("#wLabel").textContent = `${br(ds[0])} a ${br(ds[6])}`;
  const todayIdx = ds.findIndex(d => iso(d) === iso(new Date()));
  $("#thS").innerHTML = `<th>Colaborador</th><th class="n">Meta</th>` + ds.map((d, i) => `<th class="d"${i === todayIdx ? ' style="color:var(--accent)"' : ""}>${DAYS[i]}<br>${br(d)}</th>`).join("") + `<th class="n">Trabalhado</th><th style="min-width:170px">Saldo da semana</th>`;
  const fd = $("#fillDay"), keep = fd.value;
  fd.innerHTML = ds.map((d, i) => `<option value="${i}">${DAYS[i]} ${br(d)}</option>`).join("");
  fd.value = keep !== "" ? keep : String(todayIdx >= 0 ? todayIdx : 0);
  const q = $("#qS").value.trim().toLowerCase();
  let tMeta = 0, tFeito = 0, nDone = 0, nOver = 0, rows = [];
  state.emps.forEach((e, idx) => {
    analyze(e);
    const meta = sum(e.prop), w = L[e.id] || [], feito = sum(w);
    tMeta += meta; tFeito += Math.min(feito, meta);
    const rest = meta - feito;
    if (rest <= 0 && meta > 0) nDone++;
    if (rest < 0) nOver++;
    if (q && !(e.nome + " " + e.mat).toLowerCase().includes(q)) return;
    const pct = meta ? Math.min(100, feito / meta * 100) : 0;
    const restTxt = rest > 0 ? `<b>${fmt(rest)}</b> <span>restantes</span>` : rest === 0 ? `<b style="color:var(--ok)">Meta cumprida</b>` : `<b style="color:var(--warn)">+${fmt(-rest)}</b> <span>além da meta</span>`;
    const cells = DAYS.map((_, d) => {
      const v = w[d], prev = e.prop[d];
      return `<td class="d"><input class="h${prev ? "" : " off"}" id="s-${idx}-${d}" data-i="${idx}" data-d="${d}" value="${v != null && v !== "" ? fmt(v, "in") : ""}" placeholder="${prev ? fmt(prev, "in") : "folga"}" aria-label="Horas de ${esc(e.nome)} em ${DAYS[d]}"></td>`;
    }).join("");
    rows.push(`<tr><td class="who left"><b>${esc(e.nome)}</b><span>${esc(e.mat)}</span></td><td class="n">${fmt(meta)}</td>${cells}
      <td class="n">${fmt(feito)}</td>
      <td class="rest">${restTxt}<div class="meter"><i class="${rest < 0 ? "over" : rest === 0 && meta ? "done" : ""}" style="width:${pct}%"></i></div></td></tr>`);
  });
  $("#tbS").innerHTML = rows.join("") || `<tr><td colspan="11" class="hint">Nenhum colaborador encontrado.</td></tr>`;
  $("#tilesS").innerHTML = tile("Horas restantes da equipe", fmt(Math.max(0, tMeta - tFeito)), `de ${fmt(tMeta)} previstas na semana`) +
    tile("Concluído", tMeta ? Math.round(tFeito / tMeta * 100) + "%" : "0%") +
    tile("Bateram a meta", nDone, `de ${state.emps.length} colaboradores`) +
    tile("Passaram da meta", nOver, nOver ? "conferir horas extras" : "nenhuma hora extra");
}
$("#tbS").addEventListener("change", ev => {
  const t = ev.target; if (!t.matches("input.h")) return;
  const raw = t.value.trim(), v = raw === "" ? null : parseH(raw);
  if (v !== null && !horaValida(v)) { t.classList.add("bad"); return; }
  t.classList.remove("bad");
  const wk = iso(week), e = state.emps[+t.dataset.i];
  state.lanc[wk] = state.lanc[wk] || {};
  const arr = state.lanc[wk][e.id] = state.lanc[wk][e.id] || [null,null,null,null,null,null,null];
  arr[+t.dataset.d] = v;
  save(); const id = t.id; renderS(); const nx = document.getElementById(id); if (nx) nx.focus();
});
$("#btnFill").addEventListener("click", () => {
  const d = +$("#fillDay").value, wk = iso(week);
  state.lanc[wk] = state.lanc[wk] || {};
  state.emps.forEach(e => {
    analyze(e);
    const arr = state.lanc[wk][e.id] = state.lanc[wk][e.id] || [null,null,null,null,null,null,null];
    if (arr[d] == null && e.prop[d] > 0) arr[d] = e.prop[d];
  });
  save(); renderS();
});
$("#wPrev").addEventListener("click", () => { week.setDate(week.getDate() - 7); renderS(); });
$("#wNext").addEventListener("click", () => { week.setDate(week.getDate() + 7); renderS(); });
$("#wDate").addEventListener("change", ev => { if (ev.target.value) { const [y, m, d] = ev.target.value.split("-").map(Number); week = monday(new Date(y, m - 1, d)); renderS(); } });
$("#qS").addEventListener("input", renderS);

/* ---------- IMPORTAR ---------- */
function importRows(rows) {
  let novos = 0, upd = 0;
  const skip = [], invalidos = [];
  rows.forEach((r, i) => {
    const out = linhaParaColaborador(r, i);
    if (!out) return;
    if ("semHoras" in out) { skip.push(out.semHoras); return; }
    if ("invalido" in out) { invalidos.push(out.invalido); return; }
    const emp = out.colaborador;
    const ex = state.emps.findIndex(e => e.mat === emp.mat);
    if (ex >= 0) { state.emps[ex] = emp; upd++; } else { state.emps.push(emp); novos++; }
  });
  return { novos, upd, skip, invalidos };
}
function handleFile(file) {
  const msg = $("#impMsg"); msg.className = "msg"; msg.textContent = "Lendo planilha…";
  if (typeof XLSX === "undefined") { msg.className = "msg err"; msg.textContent = "Não foi possível carregar o leitor de planilhas. Verifique a conexão e recarregue a página."; return; }
  const rd = new FileReader();
  rd.onload = () => {
    try {
      const wb = XLSX.read(new Uint8Array(rd.result), { type: "array" });
      const rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { defval: "", raw: false });
      if (state.exemplo) { state.emps = []; state.lanc = {}; state.exemplo = false; }
      const r = importRows(rows);
      if (!r.novos && !r.upd) { msg.className = "msg err"; msg.textContent = (r.invalidos.length ? `Horas inválidas em: ${r.invalidos.slice(0, 5).join(", ")}. ` : "") + "Nenhum colaborador encontrado. Confira se a planilha tem a coluna Nome e as horas (por dia ou Jornada semanal)."; render(); return; }
      save(); render();
      msg.className = "msg ok";
      msg.textContent = `${r.novos} colaborador(es) importado(s)${r.upd ? `, ${r.upd} atualizado(s)` : ""}.` + (r.skip.length ? ` Sem horas informadas: ${r.skip.slice(0, 5).join(", ")}${r.skip.length > 5 ? "…" : ""}.` : "") + (r.invalidos.length ? ` Horas inválidas (não importados, confira a planilha): ${r.invalidos.slice(0, 5).join(", ")}${r.invalidos.length > 5 ? "…" : ""}.` : "") + " Veja a aba Análise.";
    } catch (e) { msg.className = "msg err"; msg.textContent = "Não consegui ler esse arquivo. Salve como .xlsx ou .csv e tente de novo."; }
  };
  rd.readAsArrayBuffer(file);
}
$("#file").addEventListener("change", ev => { const f = ev.target.files[0]; if (f) handleFile(f); ev.target.value = ""; });
const drop = $("#drop");
["dragenter","dragover"].forEach(t => drop.addEventListener(t, e => { e.preventDefault(); drop.classList.add("hover"); }));
["dragleave","drop"].forEach(t => drop.addEventListener(t, e => { e.preventDefault(); drop.classList.remove("hover"); }));
drop.addEventListener("drop", e => { const f = e.dataTransfer.files[0]; if (f) handleFile(f); });
$("#goImport").addEventListener("click", () => { location.hash = "importar"; });

$("#btnLimpar").addEventListener("click", () => $("#cfLimpar").classList.add("on"));
$("#cfNao").addEventListener("click", () => $("#cfLimpar").classList.remove("on"));
$("#cfSim").addEventListener("click", () => { state = { exemplo: false, emps: [], lanc: {}, etapa: state.etapa, limdia: state.limdia }; save(); $("#cfLimpar").classList.remove("on"); $("#impMsg").textContent = "Dados apagados."; render(); });

$("#restore").addEventListener("change", ev => {
  const f = ev.target.files[0]; if (!f) return; const rd = new FileReader();
  rd.onload = () => { try { const s = JSON.parse(rd.result); if (!Array.isArray(s.emps)) throw 0; state = s; save(); render(); $("#impMsg").className = "msg ok"; $("#impMsg").textContent = "Backup restaurado."; } catch (e) { $("#impMsg").className = "msg err"; $("#impMsg").textContent = "Arquivo de backup inválido."; } };
  rd.readAsText(f); ev.target.value = "";
});

/* ---------- downloads ---------- */
let dl = null;
if (window.claude && typeof window.claude.use === "function") window.claude.use("downloads").then(x => { dl = x; }).catch(() => {});
async function offer(filename, data) {
  const msg = $("#impMsg");
  if (dl) {
    try { await dl.save({ filename, data }); return; }
    catch (e) { if (e && e.code === "declined") return; }
  }
  try {
    const blob = data instanceof Blob ? data : new Blob([data]);
    const a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = filename;
    document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  } catch (e) { msg.className = "msg err"; msg.textContent = "O download não está disponível nesta visualização."; }
}
function xlsxFile(sheets) {
  const wb = XLSX.utils.book_new();
  sheets.forEach(([name, aoa, widths]) => { const ws = XLSX.utils.aoa_to_sheet(aoa); if (widths) ws["!cols"] = widths.map(w => ({ wch: w })); XLSX.utils.book_append_sheet(wb, ws, name); });
  return XLSX.write(wb, { bookType: "xlsx", type: "array" });
}
const hdec = m => (m ? Math.round(m / 60 * 100) / 100 : 0);
$("#btnModelo").addEventListener("click", () => {
  offer("modelo-colaboradores.xlsx", xlsxFile([["Colaboradores", [
    ["Matrícula","Nome","Cargo","Setor","Seg","Ter","Qua","Qui","Sex","Sáb","Dom"],
    ["1001","Nome do colaborador","Cargo","Setor","08:00","08:00","08:00","08:00","08:00","04:00",""],
  ], [11,30,20,16,7,7,7,7,7,7,7]]]));
});
$("#btnBackup").addEventListener("click", () => offer(`backup-jornada-${iso(new Date())}.json`, JSON.stringify(state)));
$("#btnExpA").addEventListener("click", () => {
  const head = ["Matrícula","Nome","Cargo","Setor","Jornada atual (h)","Nova meta (h)","Redução (h)", ...DAYS.map(d => d + " (h:mm)"),"Total novo (h)","Folgas","Situação","Alertas"];
  const rows = state.emps.map(e => { const a = analyze(e); return [e.mat, e.nome, e.cargo, e.setor, hdec(a.atual), hdec(a.meta), hdec(a.reduzir), ...e.prop.map(v => (v ? fmt(v, "in") : "folga")), hdec(a.tot), 7 - a.diasNv, a.precisa ? "Ajustar" : "Já conforme", a.alerts.map(x => x[1]).join("; ")]; });
  offer(`nova-escala-${state.etapa}h.xlsx`, xlsxFile([["Nova escala", [head, ...rows], [11,28,18,14,10,10,10,8,8,8,8,8,8,8,10,8,12,40]]]));
});
$("#btnExpS").addEventListener("click", () => {
  const wk = iso(week), ds = weekDates(), L = state.lanc[wk] || {};
  const head = ["Matrícula","Nome","Meta (h)", ...ds.map((d, i) => `${DAYS[i]} ${br(d)}`),"Trabalhado (h)","Restante (h)","Além da meta (h)"];
  const rows = state.emps.map(e => { analyze(e); const w = L[e.id] || [], meta = sum(e.prop), f = sum(w); return [e.mat, e.nome, hdec(meta), ...DAYS.map((_, d) => (w[d] != null ? fmt(w[d], "in") : "")), hdec(f), hdec(Math.max(0, meta - f)), hdec(Math.max(0, f - meta))]; });
  offer(`semana-${wk}.xlsx`, xlsxFile([["Semana " + br(ds[0]).replace("/", "-"), [head, ...rows], [11,28,9,10,10,10,10,10,10,10,13,12,14]]]));
});

/* ---------- geral ---------- */
function tile(l, v, s) { return `<div class="tile"><span>${l}</span><b>${v}</b>${s ? `<em>${s}</em>` : ""}</div>`; }
$("#etapa").value = String(state.etapa || 42);
$("#limdia").value = String(state.limdia || 480);
$("#etapa").addEventListener("change", ev => { state.etapa = +ev.target.value; state.emps.forEach(e => e.prop = null); save(); render(); });
$("#limdia").addEventListener("change", ev => { state.limdia = +ev.target.value; save(); render(); });
function render() {
  $("#exBanner").hidden = !state.exemplo;
  const v = location.hash.slice(1);
  if (v === "semana") renderS(); else renderA();
  $("#ctA").textContent = state.emps.length;
}
route();
})();
</script>

