# Endereço do painel da equipe
PUBLIC_DIRECTUS_URL=https://painel.g2asolucoescontabeis.com.br

# openssl rand -hex 32
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
POSTGRES_PASSWORD=

# Backblaze B2: crie um bucket privado e uma Application Key restrita a ele
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Ex.: us-east-005 (aparece no endpoint S3 do bucket)
B2_REGION=

# Gerado por npm run directus:setup (rodar após o primeiro deploy)
DIRECTUS_TOKEN=

# Opcionais (os valores padrão já servem)
# Proxies confiáveis na frente do site (Traefik do Dokploy = 1)
TRUSTED_PROXY_HOPS=1
# Requisições por IP por minuto: geral e só para /arquivos
RATE_LIMIT_GERAL=600
RATE_LIMIT_ARQUIVOS=180
# Dias de retenção dos backups diários do Postgres
BACKUP_RETENTION_DAYS=14
